# 复制为 key.properties 并填入自己的签名信息；该文件已被 .gitignore 忽略，切勿提交。
# 生成 keystore：
#   keytool -genkeypair -v -keystore livebetter-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias livebetter
#
# storeFile 相对 app/android/ 目录解析。
storePassword=your-store-password
keyPassword=your-key-password
keyAlias=livebetter
storeFile=livebetter-release.jks
